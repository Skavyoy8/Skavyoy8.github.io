---
import Base from '../layouts/Base.astro';
import { SECTIONS, GLOSSAIRE } from '../lib/sections.js';
import { pagesDe } from '../lib/navigation.js';


const compte = {};
for (const s of [...SECTIONS, GLOSSAIRE]) {
  compte[s.id] = (await pagesDe(s.id)).length;
}
const total = Object.values(compte).reduce((a, b) => a + b, 0);
---
<Base titre="Accueil" description="Wiki technique sur le fonctionnement de la crypto et d'OKX.">
  <article class="article">
    <h1 class="page-titre">Comment marche la crypto</h1>
    <p class="page-resume">
      Un site pour comprendre, expliqué depuis le début, sans rien supposer de connu.
    </p>

    <div class="contenu">
      <p>
        Ce site explique <strong>comment ça fonctionne</strong>. Il ne donne aucun
        conseil, ne recommande rien à acheter et n'a rien à te vendre. Chaque
        affirmation s'appuie sur une source, et les chiffres sont calculés, pas
        recopiés.
      </p>

      <p>
        Si tu n'y connais rien, commence par ces trois pages, dans l'ordre :
      </p>

      <ol class="depart">
        <li><a href="/commencer/cest-quoi-la-crypto">C'est quoi la crypto ?</a></li>
        <li><a href="/commencer/cest-quoi-une-blockchain">C'est quoi une blockchain ?</a></li>
        <li><a href="/commencer/acheter-sur-okx">Ce qui se passe quand tu achètes sur une plateforme</a></li>
      </ol>

      <p>Ensuite, pioche selon ce qui t'intéresse :</p>

      <ul class="grille-sections">
        {SECTIONS.map((s) => (
          <li>
            <a href={`/${s.id}`}>
              <span class="grille-sections__titre">{s.titre}</span>
              <span class="grille-sections__resume">{s.resume}</span>
              <span class="grille-sections__compte">
                {compte[s.id] === 0 ? 'à écrire' : `${compte[s.id]} page${compte[s.id] > 1 ? 's' : ''}`}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p><a href={`/${GLOSSAIRE.id}`}>Glossaire</a> — {compte[GLOSSAIRE.id]} terme(s) définis.</p>
      <p class="discret">{total} page(s) publiées pour l'instant.</p>
    </div>
  </article>
</Base>
