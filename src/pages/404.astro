---
import Base from '../layouts/Base.astro';
---
<Base titre="Page introuvable">
  <article class="article">
    <h1 class="page-titre">404</h1>
    <p class="page-resume">Cette page n'existe pas, ou pas encore.</p>
    <div class="contenu">
      <p>Utilise la recherche (touche <kbd>/</kbd>) ou reviens à l'<a href="/">accueil</a>.</p>
    </div>
  </article>
</Base>
