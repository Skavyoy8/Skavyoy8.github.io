---
import { render } from 'astro:content';
import PageContenu from '../../layouts/PageContenu.astro';
import { TOUTES, parId } from '../../lib/sections.js';
import { voisines, titresParUrl, pagesDe } from '../../lib/navigation.js';
import datesGit from '../../lib/dates-git.json';

export async function getStaticPaths() {
  const routes = [];
  for (const section of TOUTES) {
    for (const entree of await pagesDe(section.id)) {
      routes.push({ params: { section: section.id, slug: entree.id }, props: { entree } });
    }
  }
  return routes;
}

const { entree } = Astro.props;
const { section } = Astro.params;

const { Content, headings } = await render(entree);

// `maj` du frontmatter s'il est renseigné, sinon la date du dernier
// commit qui a touché le fichier — voir scripts/dates-git.mjs.
const cheminRelatif = entree.filePath;
const dateGit = cheminRelatif ? datesGit[cheminRelatif] : undefined;
const maj = entree.data.maj ?? (dateGit ? new Date(dateGit) : undefined);
---
<PageContenu
  section={parId[section]}
  donnees={entree.data}
  headings={headings}
  maj={maj}
  titresPrerequis={await titresParUrl()}
  voisines={await voisines(section, entree.id)}
>
  <Content />
</PageContenu>
