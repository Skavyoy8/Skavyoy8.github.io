---
interface Props {
  sources: { titre: string; url: string }[];
}
// Les modèles Obsidian pré-remplissent des entrées vides : on les écarte.
const sources = Astro.props.sources.filter((s) => s.titre.trim() || s.url.trim());
---
{sources.length > 0 && (
  <section class="sources">
    <h2>Sources</h2>
    <ol>
      {sources.map((s) => (
        <li>
          {s.url
            ? <a href={s.url} rel="noopener noreferrer" target="_blank">{s.titre || s.url}</a>
            : s.titre}
        </li>
      ))}
    </ol>
  </section>
)}
